# install_python.sub -- HTCondor smoke test for the analysis environment.
#
#     cd .../NanoTuplePlot/venv_lxplus
#     kinit                                 # needed for MY.SendCredential below
#     condor_submit install_python.sub
#     watch condor_q -nobatch
#     cat out/test_env.*.out
#
# NOTE this does NOT install anything. You install interactively with
# `bash install_venv.sh` (see README). What this job is for is proving that the
# environment also works on a worker node, which is a different and more useful
# thing to check.

universe                = vanilla
executable              = run.sh
arguments               = python test_env.py

# The job starts in condor's scratch dir, so the scripts need an absolute path
# back to this folder. $ENV(PWD) is expanded by condor_submit on the submit
# host, so this works as long as you submit from inside venv_lxplus/.
environment             = "STOP_ENV_PREFIX=$ENV(PWD) USER=$ENV(USER)"

# EL7 comes from the image, not from `cmssw-el7`: CERN's pool already starts
# jobs inside apptainer, and nesting the wrapper inside that fails.
# [Confirm this path with probe_lxplus.sh / ls /cvmfs/unpacked.cern.ch/...]
MY.SingularityImage     = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"

# A batch job has no kerberos token by default, so it cannot read /afs at all --
# and the venv lives on /afs. Requires a valid ticket at submit time (`kinit`).
MY.SendCredential       = True

output                  = out/test_env.$(ClusterId).$(ProcId).out
error                   = error/test_env.$(ClusterId).$(ProcId).err
log                     = log/test_env.$(ClusterId).log

request_cpus            = 1
request_memory          = 2000
+JobFlavour             = "espresso"

# keep and send back output even if execution fails
WHEN_TO_TRANSFER_OUTPUT = ON_EXIT_OR_EVICT

queue 1

# -----------------------------------------------------------------------------
# For real analysis jobs, keep everything above and replace the `queue 1` with a
# table, following the shape of sample_reweighting/write_condor_jobs_weight_*.py:
#
#   arguments = python $(script) --sample $(sample) --year 2018
#   queue script, sample from (
#       1DPlot_LL_BR_weighted_bothBR_newComb_peselection.py, Sig_Splitted_500_490_0.3
#       1DPlot_LL_BR_weighted_bothBR_newComb_peselection.py, Sig_Splitted_500_490_1.0
#   )
#
# and remember run.sh does not change directory -- add an `initialdir` pointing
# at the pipeline's own folder, since the scripts rely on relative
# sys.path.append entries resolving against the working directory.
#
# Note also: the LL FileLists still point at local /mnt/newDisk/... paths that do
# not exist on lxplus. See README.md.
#
# espresso     = 20 minutes      workday   = 8 hours
# microcentury = 1 hour          tomorrow  = 1 day
# longlunch    = 2 hours         testmatch = 3 days
#
# condor_q -nobatch ; condor_rm <clusterId> ; condor_release <clusterId>
# -----------------------------------------------------------------------------
