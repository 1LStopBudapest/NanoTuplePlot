# Everything the install generates. The repo should only carry the files that
# DO the installing, so that a fresh checkout + install_venv.sh reproduces it.

venv_folder/
cache/
log/
out/
error/
*.pyc
probe_output.txt

# only if the cmsrel fallback in install_venv.sh is ever used
CMSSW_*/

# requirements.lock.txt is deliberately NOT ignored -- it is the reproducible
# record of what pip actually resolved, and should be committed.
