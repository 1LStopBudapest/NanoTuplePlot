# probe_worker.sub -- ONE job, to see what a CERN batch node looks like before
# submitting the 1750 real ones.
#
#     cd .../NanoTuplePlot/CutFlow_study_LL
#     kinit                                    # needed to reach /eos from the job
#     condor_submit probe_worker.sub
#     condor_q -nobatch
#     cat jobs_2018/probe_worker.*.out         # read the VERDICT block at the end

universe              = vanilla
executable            = probe_worker.sh
arguments             = probe_worker.py

# Absolute path back to this folder, expanded by condor_submit on the submit
# host. USER is passed because Sample/Dir.py reads os.environ['USER'] unguarded.
environment           = "STOPANA_DIR=$ENV(PWD) USER=$ENV(USER)"

# EL7 from the image, not from `cmssw-el7`: the pool already starts jobs inside
# apptainer and nesting the wrapper fails.
MY.SingularityImage   = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"

# Without a kerberos token the job cannot read /eos at all.
MY.SendCredential     = True

output                = jobs_2018/probe_worker.$(ClusterId).$(ProcId).out
error                 = jobs_2018/probe_worker.$(ClusterId).$(ProcId).error
log                   = jobs_2018/probe_worker.$(ClusterId).log

request_cpus          = 1
request_memory        = 2000
+JobFlavour           = "espresso"

WHEN_TO_TRANSFER_OUTPUT = ON_EXIT_OR_EVICT

queue 1
